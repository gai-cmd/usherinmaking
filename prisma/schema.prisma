// usherinmaking — 데이터 모델
//
// 프론트는 우선 src/content/*.ts 하드코딩으로 동작하고, 이 스키마가 이관 목적지다.
// content 모듈의 필드 이름을 여기에 맞춰 두었으므로 이관은 드롭인이 된다.
//
// 다국어 필드는 Json { ja, en, ko } 로 둔다. 언어별로 독립된 본문을 운영하기 때문에
// 별도 번역 테이블이 아니라 레코드 하나가 3개 언어를 함께 들고 있는 편이 관리자 화면과 맞는다.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7부터 접속 URL은 스키마가 아니라 prisma.config.ts 와
// PrismaClient 어댑터가 들고 있다. 여기에는 provider만 남는다.
datasource db {
  provider = "postgresql"
}

/* ============================ 사진 ============================ */

enum PhotoStatus {
  UNSORTED // 수집만 된 상태. 프론트에 노출되지 않는다.
  PUBLISHED // 관리자가 전시로 선택한 것만 노출된다.
  ARCHIVED // 서버에는 남기고 비공개
}

model Photo {
  id String @id @default(cuid())

  // 어느 인스타 계정에서 왔는가. 'main'(작품) / 'dress'(드레스 컬렉션).
  // 갤러리는 main 만 보여준다 — 드레스 사진이 작품 격자에 섞이면 안 된다.
  igAccount String @default("main")

  // 인스타 원본 id. 수동 업로드는 null.
  igMediaId String? @unique

  originalUrl String // 자사 스토리지 원본 (동영상이면 포스터 이미지)
  variants    Json // { avif: { 400, 800, 1600 }, webp: {...} }
  width       Int
  height      Int

  // 'image' | 'video'. 동영상(릴스)은 originalUrl/variants 가 포스터, videoUrl 이 mp4 다.
  mediaType String  @default("image")
  videoUrl  String?

  caption String?
  takenAt DateTime

  status PhotoStatus @default(UNSORTED)

  // 장변 2000px 미만 등. 관리자 화면에서 경고 배지 + 원본 교체 유도.
  lowRes Boolean @default(false)

  alt   Json // { ja, en, ko } — 3개 언어 모두 필수
  story Json? // 작품 상세 1문단 { ja, en, ko }

  // AI 배치가 제안한 분류. 확정은 반드시 관리자가 한다.
  aiSuggestion Json? // [{ taxonomyId, termId, score }]

  isCover Boolean @default(false)

  /// 갤러리 사진 상세의 주소(`/gallery/g/{slug}`).
  /// DB 에는 있었는데 이 스키마에 빠져 있었다 — 그 상태로 `db push` 를 돌리면 145장의 주소가
  /// 통째로 지워진다(2026-08-09 실측으로 잡았다). 실제 DB 정의(text, nullable, unique) 그대로 적는다.
  slug String? @unique

  /// 같은 촬영에서 나온 사진 묶음의 이름. 갤러리가 "촬영 1건 = 카드 1개"로 보여줄 때 쓴다.
  /// 비어 있으면 그 사진 한 장이 곧 하나의 묶음이다(낱장 업로드).
  /// 네이버에서 옮겨온 사진은 그 글의 slug 를 쓴다 — 어느 촬영인지가 곧 어느 글인지다.
  shootKey String?

  /// 묶음 안에서의 순서. 표지가 0, 본문 사진이 1부터. 원문의 사진 순서를 잃지 않기 위한 것이다.
  shootOrder Int @default(0)

  terms PhotoTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, takenAt])
  @@index([shootKey, shootOrder])
}

/* ======================= 분류 (관리자가 축을 늘릴 수 있다) ======================= */

model Taxonomy {
  id    String @id @default(cuid())
  key   String @unique // place / shootType / set / season ...
  label Json // { ja, en, ko }
  order Int    @default(0)

  terms Term[]
}

model Term {
  id String @id @default(cuid())

  taxonomyId String
  taxonomy   Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  slug  String // URL 세그먼트. 갤러리 필터가 경로이므로 이 값이 곧 주소가 된다.
  label Json // { ja, en, ko }
  order Int    @default(0)

  // 세트는 STUDIO 하위처럼 계층을 가진다.
  parentId String?
  parent   Term?   @relation("TermTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Term[]  @relation("TermTree")

  photos PhotoTerm[]

  @@unique([taxonomyId, slug])
}

model PhotoTerm {
  photoId String
  termId  String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  term  Term  @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([photoId, termId])
  @@index([termId])
}

/* ============================ 플랜 · 옵션 ============================ */

enum Scope {
  STUDIO
  LOCATION
  ANNIVERSARY
  HAIRMAKE
}

model Plan {
  id    String @id @default(cuid())
  code  String @unique // studio-01, location-simple ...
  scope Scope

  title Json // { ja, en, ko }

  listPrice Int? // 정가 (모니터 가격 표기용)
  price     Int

  // 税込 표기는 로케이션·기념사진에만. 스튜디오 플랜은 근거가 없어 false.
  taxIncluded Boolean @default(false)

  duration Json // { ja, en, ko }
  cuts     Int?
  includes Json // { ja: string[], en: string[], ko: string[] }

  order Int @default(0)

  options PlanOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id    String @id @default(cuid())
  label Json
  price Json // { amount, suffix } 또는 범위
  note  Json
  order Int    @default(0)

  plans PlanOption[]
}

model PlanOption {
  planId   String
  optionId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([planId, optionId])
}

/* ============================ 문의 ============================ */

enum InquiryStatus {
  NEW
  WAITING
  DONE
  HOLD
  SPAM
}

/// DB가 원본이다. 메일·LINE 알림은 사본일 뿐이므로 알림 실패가 문의 유실이 되면 안 된다.
model Inquiry {
  id String @id @default(cuid())

  name   String
  email  String
  locale String // ja | en | ko

  shootType String
  dates     String?
  people    String?
  message   String

  status InquiryStatus @default(NEW)
  memo   String?

  // 문의 문장을 그대로 FAQ로 승격했을 때의 연결
  promotedFaqId String?
  promotedFaq   Faq?    @relation(fields: [promotedFaqId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  repliedAt DateTime?

  @@index([status, createdAt])
}

/// FAQ는 실제 문의 문장 그대로 쓴다. 관리자가 INBOX에서 승격한다.
model Faq {
  id       String  @id @default(cuid())
  question Json // { ja, en, ko }
  answer   Json
  order    Int     @default(0)
  page     String? // 어느 페이지에 노출할지 (home / studio / contact ...)

  inquiries Inquiry[]
}

/* ============================ 촬영후기 ============================ */

model JournalPost {
  id String @id @default(cuid())

  slug   String
  locale String // 언어별 독립 본문이므로 slug + locale 조합이 유일하다

  category String
  title    String
  body     String
  cover    String

  planCode String? // 글 하단 CTA가 가리킬 플랜
  source   String? // naver-blog | manual

  // 시안의 글은 전부 샘플이다. 실제 원고로 교체되기 전까지 배지로 표시한다.
  isSample Boolean @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, locale])
  @@index([locale, publishedAt])
}

/* ======================= 페이지 콘텐츠 (CMS) ======================= */

/// 페이지 문구의 덮어쓰기 레이어.
///
/// 원본 카피는 src/content/* 와 각 페이지의 content.ts 에 그대로 남는다.
/// 이 테이블에 행이 있으면 그 값이 이기고, 없으면 코드의 기본값이 나간다.
/// 통째로 DB로 옮기지 않는 이유: 행이 하나 비면 화면이 빈칸이 되는 상태를 만들지 않기 위해서다.
model PageContent {
  id String @id @default(cuid())

  /// 페이지 키 — home / studio / location / dress / plan / photographer / journal / gallery / contact
  page   String
  /// 페이지 안에서의 자리. 코드의 슬롯 이름과 1:1 (예: hero.location.title, lead.body)
  slot   String
  locale String // ja | en | ko

  value String

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([page, slot, locale])
  @@index([page, locale])
}

/// 이미지 슬롯. 페이지의 특정 자리에 어떤 이미지를 걸지.
///
/// Photo(인스타 수집분)와 분리한 이유: 히어로·세트컷처럼 "이 자리에 이 사진"인 것과,
/// 갤러리처럼 "모아서 고르는" 것은 수명주기가 다르다.
model PageImage {
  id String @id @default(cuid())

  page String
  slot String

  /// 스토리지 공개 URL. 로컬 /images/* 경로도 그대로 넣을 수 있다.
  url    String
  width  Int?
  height Int?

  /// { ja, en, ko } — 3개 언어 모두 있어야 게시로 본다.
  alt Json

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([page, slot])
  @@index([page])
}

/// 업로드된 미디어 원본. 관리자가 올린 것과 인스타에서 수집한 것이 함께 들어온다.
model MediaAsset {
  id String @id @default(cuid())

  url      String  @unique
  pathname String?
  mimeType String?
  size     Int?
  width    Int?
  height   Int?

  /// manual | instagram
  source     String  @default("manual")
  uploadedBy String?

  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

/* ============================ 관리자 ============================ */

/// 관리자 멤버 명부.
///
/// 주의: 통과 판정의 근거는 이 테이블이 아니라 환경변수 ADMIN_ALLOWED_EMAILS 다.
/// 목록을 DB에만 두면 관리자 화면을 통해 목록 자체를 바꿀 수 있게 되어,
/// 세션 하나가 털렸을 때 공격자가 스스로를 멤버로 추가할 수 있다.
/// 이 테이블은 "누가 있는지 보여주고 마지막 접속을 기록하는" 표시·감사용이다.
model AdminMember {
  id    String @id @default(cuid())
  email String @unique
  name  String?

  /// 환경변수 목록과 일치하는지. 불일치는 관리자 화면에서 경고로 띄운다.
  inAllowlist Boolean @default(false)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
}

/* ============================ 운영 ============================ */

model ActivityLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 런타임에 값이 바뀌는 설정. 환경변수는 배포 시점에 고정되어 갱신할 수 없으므로,
/// 스스로 연장되는 인스타 장기 토큰처럼 "코드가 쓰는" 값은 여기 산다.
/// 비밀값이 들어오므로 관리자 화면은 절대 원문을 되돌려 주지 않는다(server/ig-token.ts 참조).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 인스타 수집 크론의 실행 기록. 중복 수집과 누락을 판별하려면 실행 자체가 남아야 한다.
model IngestRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  fetched    Int       @default(0)
  created    Int       @default(0)
  failed     Int       @default(0)
  error      String?
}
