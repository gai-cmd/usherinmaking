# usherinmaking — 환경 변수
# 실제 값은 .env.local (로컬) / Vercel 프로젝트 환경 변수(배포)에 넣는다. 저장소에 커밋 금지.

# ---------- 사이트 ----------
# 절대 URL 생성(canonical, hreflang, sitemap, OG)에 쓰인다. 커스텀 도메인 확정 시 교체.
NEXT_PUBLIC_SITE_URL="https://usherinmaking.vercel.app"

# ---------- 데이터베이스 ----------
# prisma/schema.prisma 의 datasource. Neon 또는 Supabase의 Postgres 연결 문자열.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---------- 관리자 인증 (구글 SSO) ----------
# 비밀번호를 우리가 보관하지 않는다. 구글이 신원을 확인하고, 아래 허용 목록이 관리자를 정한다.
#
# 1) Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (웹 애플리케이션)
# 2) 승인된 리디렉션 URI 에 다음을 등록:
#      https://<배포도메인>/api/auth/callback/google
#      http://localhost:3000/api/auth/callback/google   (로컬 개발용)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 세션 토큰 서명 키. `openssl rand -base64 32` 로 생성한다.
AUTH_SECRET=""

# 관리자로 들어올 수 있는 구글 계정. 쉼표로 구분한다.
#   예: ADMIN_ALLOWED_EMAILS="owner@gmail.com,staff@gmail.com"
#
# 목록을 DB가 아니라 환경변수에 두는 이유: DB에 두면 관리자 화면을 통해 목록 자체를 바꿀 수
# 있게 되어, 세션 하나가 털렸을 때 공격자가 스스로를 멤버로 추가할 수 있다.
# 환경변수는 배포 권한이 있어야 바꿀 수 있으므로 침해와 권한 부여가 분리된다.
#
# 비어 있으면 관리자 화면과 API는 열리지 않고 닫힌다(통과가 아니라 실패).
ADMIN_ALLOWED_EMAILS=""

# ---------- 크론 ----------
# /api/cron/ingest-instagram 을 외부에서 임의로 호출하지 못하게 하는 공유 비밀.
# Vercel Cron이 Authorization 헤더로 전달한다.
CRON_SECRET=""

# ---------- 인스타그램 수집 ----------
# Instagram Graph API. 6시간 주기로 계정 게시물을 전량 조회한다.
IG_USER_ID=""
IG_ACCESS_TOKEN=""

# ---------- 오브젝트 스토리지 ----------
# 인스타 원본을 자사에 보관하고, 사이트는 여기서 재인코딩본을 서빙한다.
# 임베드·아웃링크를 쓰지 않는 것이 SEO/AEO상 핵심이므로 이 경로가 원본의 집이 된다.
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# ---------- 상담 창구 ----------
# 상담은 메신저로만 받는다 — 문의 폼과 메일 접수는 운영하지 않으므로 메일 발송 설정이 없다.
# 링크는 관리자 화면(설정 → 언어별 상담 채널)에서 바꾸고, 아래 값은 그 폴백이다.
KAKAO_CHANNEL_URL=""
LINE_OFFICIAL_URL=""

# ---------- 외부 서비스 대장 (/admin/services) ----------
# 관리자 화면에 보관하는 API 키·비밀번호를 봉인하는 열쇠.
# DB 밖에 있어야 의미가 있다 — DB 덤프만으로는 값을 열 수 없게 하는 것이 목적이다.
# 없으면 자격 증명 저장을 거부한다(평문으로 남기지 않기 위해서다).
# 만드는 법: openssl rand -base64 32
SERVICE_VAULT_KEY=""

# ---------- AI 분류 ----------
# 수집된 사진의 카테고리·alt 초안을 제안한다. 확정은 언제나 관리자가 한다.
AI_API_KEY=""
